{
    "name": "forumaker/statser",
    "description": "Adds a live online widget — see who's browsing and what page they're on",
    "keywords": [
        "flarum",
        "flarum-extension",
        "statistics",
        "widget",
        "online-users",
        "tiles"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "homepage": "https://github.com/forumaker/Statser",
    "support": {
        "issues": "https://github.com/forumaker/Statser/issues",
        "source": "https://github.com/forumaker/Statser"
    },
    "authors": [
        {
            "name": "forumaker",
            "role": "Developer",
            "email": "arsenygpt@gmail.com",
            "homepage": "https://github.com/forumaker"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0.0"
    },
    "autoload": {
        "psr-4": {
            "forumaker\\Statser\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        },
        "flarum-extension": {
            "title": "Statser",
            "category": "feature",
            "icon": {
                "name": "fas fa-location-arrow",
                "backgroundColor": "#BC3D38",
                "color": "#ffffff"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "flarum/testing": "^2.0.0"
    },
    "autoload-dev": {
        "psr-4": {
            "forumaker\\Statser\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php"
    }
}
